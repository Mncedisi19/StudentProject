# Copy this file to .env.local before running the app.

# Secret used to sign JWT auth tokens. Change this to any long random string.
JWT_SECRET=munifix-dev-secret-change-me-in-production

# SQLite database file location (relative to project root). Created automatically.
DATABASE_FILE=./db/munifix.sqlite

# Hours a SUBMITTED complaint has before it is auto-flagged overdue if not yet ASSIGNED.
SUBMITTED_DEADLINE_HOURS=24

# Hours an ASSIGNED/IN_PROGRESS complaint has before it is auto-flagged overdue by priority.
DEFAULT_DEADLINE_HOURS=48
